{
	"name": "@nestm/email",
	"version": "0.1.0-alpha.0",
	"description": "Provider-neutral email delivery for NestJS 12 with pluggable transports, renderers, typed DI, and testing utilities.",
	"license": "BSD-3-Clause",
	"author": "nestm",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nestm-dev/email.git"
	},
	"homepage": "https://github.com/nestm-dev/email#readme",
	"bugs": {
		"url": "https://github.com/nestm-dev/email/issues"
	},
	"keywords": [
		"nestjs",
		"nestjs-12",
		"email",
		"react-email",
		"resend",
		"nodemailer",
		"mailer",
		"esm",
		"nestm"
	],
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.20.0",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./core": {
			"types": "./dist/core/index.d.mts",
			"import": "./dist/core/index.mjs",
			"default": "./dist/core/index.mjs"
		},
		"./renderers/react-email": {
			"types": "./dist/renderers/react-email/index.d.mts",
			"import": "./dist/renderers/react-email/index.mjs",
			"default": "./dist/renderers/react-email/index.mjs"
		},
		"./transports/resend": {
			"types": "./dist/transports/resend/index.d.mts",
			"import": "./dist/transports/resend/index.mjs",
			"default": "./dist/transports/resend/index.mjs"
		},
		"./transports/nodemailer": {
			"types": "./dist/transports/nodemailer/index.d.mts",
			"import": "./dist/transports/nodemailer/index.mjs",
			"default": "./dist/transports/nodemailer/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing/index.d.mts",
			"import": "./dist/testing/index.mjs",
			"default": "./dist/testing/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"SECURITY.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch src",
		"build:tsc": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
		"test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:types",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"test:types": "tsc -p tests/types/tsconfig.json",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:packed-types": "tsc -p tests/packed-types/tsconfig.json",
		"verify:pack": "pnpm run build && publint --strict && pnpm run test:packed-types",
		"verify": "pnpm run check && pnpm run test && pnpm run verify:pack && pnpm exec attw --pack . --profile esm-only",
		"prepack": "pnpm run build",
		"changeset": "changeset",
		"release": "node scripts/publish.mjs"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0-alpha.5",
		"@nestjs/core": "^12.0.0-alpha.5",
		"@react-email/render": "^2.1.0",
		"nodemailer": "^9.0.5",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.18.1",
		"rxjs": "^7.8.0"
	},
	"peerDependenciesMeta": {
		"@nestjs/common": {
			"optional": true
		},
		"@nestjs/core": {
			"optional": true
		},
		"@react-email/render": {
			"optional": true
		},
		"nodemailer": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"reflect-metadata": {
			"optional": true
		},
		"resend": {
			"optional": true
		},
		"rxjs": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/cli": "2.31.1",
		"@nestjs/common": "12.0.0-alpha.5",
		"@nestjs/core": "12.0.0-alpha.5",
		"@nestjs/testing": "12.0.0-alpha.5",
		"@react-email/render": "2.1.0",
		"@types/node": "26.1.2",
		"@types/nodemailer": "8.0.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitest/coverage-v8": "4.1.10",
		"nodemailer": "9.0.5",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"publint": "0.3.23",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"reflect-metadata": "0.2.2",
		"resend": "6.18.1",
		"rxjs": "7.8.2",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
